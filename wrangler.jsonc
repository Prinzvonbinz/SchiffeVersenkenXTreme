{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schiffeversenkenxtreme",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
